# Local development values only; do not reuse in shared or production systems.
POSTGRES_DB=jungle
POSTGRES_USER=jungle
POSTGRES_PASSWORD=jungle-local-password
DATABASE_URL=postgres://jungle:jungle-local-password@localhost:5432/jungle?sslmode=disable

KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-password

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_OUTPUT_QUEUE_NAME=wager-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_OUTPUT_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

OIDC_ISSUER_URL=http://localhost:8081/realms/jungle-local
OIDC_AUDIENCE=jungle-api
OIDC_INTERNAL_URL=

HTTP_ADDR=:8080
STARTUP_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s

# Integration tests use real PostgreSQL, LocalStack and Keycloak from Compose.
TEST_DATABASE_URL=postgres://jungle:jungle-local-password@localhost:5432/jungle?sslmode=disable
TEST_SQS_ENDPOINT=http://localhost:4566
TEST_SQS_INPUT_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
TEST_SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
TEST_SQS_OUTPUT_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
TEST_OIDC_ISSUER=http://localhost:8081/realms/jungle-local
TEST_OIDC_AUDIENCE=jungle-api
TEST_OIDC_CLIENT_ID=provider-a
TEST_OIDC_CLIENT_SECRET=provider-a-local-secret
TEST_OIDC_PROVIDER_ID=provider-a
TEST_OIDC_INTERNAL_CLIENT_ID=internal-service
TEST_OIDC_INTERNAL_CLIENT_SECRET=internal-local-secret
TEST_OIDC_PROVIDER_A_CLIENT_ID=provider-a
TEST_OIDC_PROVIDER_A_CLIENT_SECRET=provider-a-local-secret
TEST_OIDC_INTERNAL_URL=
